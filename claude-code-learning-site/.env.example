# === 微信支付配置 ===
# 商户号（微信商户平台 → 账户中心 → 商户信息）
WECHAT_MCH_ID=mch_xxxxxxxxxxxxx
# API v3 密钥（商户平台 → API安全 → 设置APIv3密钥）
WECHAT_API_KEY=your_32_char_api_v3_key_here
# 商户API证书序列号（商户平台 → API安全 → 申请API证书）
WECHAT_CERT_SERIAL_NO=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 商户API私钥（apiclient_key.pem 文件内容，Base64 或直接粘贴）
WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
your_private_key_here
-----END PRIVATE KEY-----"
# 支付结果通知地址（必须是公网可访问的 HTTPS URL）
WECHAT_NOTIFY_URL=https://你的域名.vercel.app/api/payment-notify
# 微信支付平台证书（PEM 格式，用于验证回调签名。从微信商户平台下载）
WECHAT_PLATFORM_CERT="-----BEGIN CERTIFICATE-----
your_platform_cert_here
-----END CERTIFICATE-----"
# 微信支付平台证书序列号（与上方证书匹配）
WECHAT_PLATFORM_CERT_SNO=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# === Supabase 配置 ===
# 项目 URL（Supabase 控制台 → Settings → API → Project URL）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 匿名密钥（Supabase 控制台 → Settings → API → anon key）
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role 密钥（仅后端用，绝不要放前端！）
SUPABASE_SERVICE_ROLE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
